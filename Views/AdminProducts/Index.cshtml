@model List<GlowyOre.Models.Product>
@{
    ViewData["Title"] = "Products";
    ViewData["AdminTitle"] = "Products";
    ViewData["ActiveAdmin"] = "products";
    var query = ViewBag.Query as string;
}

<div class="admin-page-head">
    <p>All your ornaments in one place — prices, stock and visibility.</p>
    <div class="actions">
        <form class="search-box" method="get" action="/admin/products">
            <input type="search" name="q" value="@query" placeholder="Search products…" aria-label="Search products" />
            <button type="submit" aria-label="Search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            </button>
        </form>
        <a class="btn btn-primary btn-sm" href="/admin/products/create">+ New product</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">
        <div class="empty-icon">✦</div>
        <h2>@(string.IsNullOrWhiteSpace(query) ? "No products yet" : "Nothing matched that search")</h2>
        <p>@(string.IsNullOrWhiteSpace(query) ? "Add your first ornament — name it, price it, upload a few photos." : "Try a different word, or clear the search to see everything.")</p>
        @if (string.IsNullOrWhiteSpace(query))
        {
            <a class="btn btn-primary btn-sm" href="/admin/products/create">Add the first product</a>
        }
        else
        {
            <a class="btn btn-ghost btn-sm" href="/admin/products">Clear search</a>
        }
    </div>
}
else
{
    <div class="panel">
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Visibility</th>
                        <th>Added</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-product">
                                    <span class="cell-img">
                                        <img src="/@(product.PrimaryImage ?? "images/placeholder.svg")" alt="@product.Name" />
                                    </span>
                                    <div>
                                        <div class="cell-name">@product.Name</div>
                                        <div class="cell-sub">@product.Images.Count pics · /@product.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td>@product.Category?.Name</td>
                            <td>
                                @Format.Money(product.Price)
                                @if (product.HasDiscount)
                                {
                                    <div class="cell-sub"><s>@Format.Money(product.CompareAtPrice)</s></div>
                                }
                            </td>
                            <td>
                                @if (product.Stock <= 0)
                                {
                                    <span class="pill status-cancelled">Sold out</span>
                                }
                                else if (product.Stock <= 5)
                                {
                                    <span class="pill status-pending">@product.Stock left</span>
                                }
                                else
                                {
                                    <span>@product.Stock</span>
                                }
                            </td>
                            <td>
                                <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                                    <span class="pill @(product.IsActive ? "pill-active" : "pill-hidden")">@(product.IsActive ? "Live" : "Hidden")</span>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="pill pill-featured">Featured</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-sub">@Format.DateLocal(product.CreatedAt)</td>
                            <td>
                                <div class="cell-actions">
                                    <a class="icon-btn" href="/admin/products/edit/@product.Id" aria-label="Edit @product.Name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" /></svg>
                                    </a>
                                    <form class="inline-form" method="post" action="/admin/products/delete/@product.Id"
                                          data-confirm="Delete “@product.Name” permanently? Past orders keep their record.">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-btn danger" type="submit" aria-label="Delete @product.Name">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13M10 11v6M14 11v6" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
