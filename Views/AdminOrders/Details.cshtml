@model GlowyOre.Models.Order
@{
    ViewData["Title"] = Model.OrderNumber;
    ViewData["AdminTitle"] = Model.OrderNumber;
    ViewData["ActiveAdmin"] = "orders";
}

<div class="admin-page-head">
    <p>Placed @Format.DateTimeLocal(Model.CreatedAt) · @Model.PaymentMethod</p>
    <div class="actions">
        <span class="pill status-@Model.Status.ToLowerInvariant()">@Model.Status</span>
        <a class="btn btn-ghost btn-sm" href="/admin/orders">← All orders</a>
    </div>
</div>

<div class="order-meta-grid">
    <div class="panel">
        <div class="panel-head">
            <h2>Items</h2>
            <span style="font-size: 11.5px; color: var(--muted);">@Model.Items.Sum(i => i.Quantity) pieces</span>
        </div>
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit price</th>
                        <th>Qty</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="cell-product">
                                    <span class="cell-img">
                                        <img src="/@(item.ImagePath ?? "images/placeholder.svg")" alt="@item.ProductName" />
                                    </span>
                                    <span class="cell-name">@item.ProductName</span>
                                </div>
                            </td>
                            <td>@Format.Money(item.UnitPrice)</td>
                            <td>@item.Quantity</td>
                            <td>@Format.Money(item.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="order-line-total">
            <span>Order total</span>
            <strong>@Format.Money(Model.Total)</strong>
        </div>
    </div>

    <div>
        <div class="panel" style="margin-bottom: 18px;">
            <div class="panel-head"><h2>Customer</h2></div>
            <div class="panel-body">
                <div class="order-summary-box">
                    <p><strong>@Model.CustomerName</strong></p>
                    <p>@Model.Phone</p>
                    <p>@Model.Address</p>
                    <p>@Model.City</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <p style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed rgba(124,53,80,.2);">
                            <em>“@Model.Note”</em>
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-head"><h2>Status &amp; total</h2></div>
            <div class="panel-body">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong>@Format.Money(Model.Subtotal)</strong>
                </div>
                <div class="summary-row">
                    <span>Delivery</span>
                    <strong>@(Model.DeliveryFee == 0 ? "Free" : Format.Money(Model.DeliveryFee))</strong>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <strong>@Format.Money(Model.Total)</strong>
                </div>

                <form class="status-form" method="post" action="/admin/orders/@Model.Id/status">
                    @Html.AntiForgeryToken()
                    <select name="status" aria-label="Order status">
                        @foreach (var s in OrderStatuses.All)
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" type="submit">Update</button>
                </form>
                <p style="font-size: 11px; color: var(--muted); margin-top: 10px;">The customer sees updates when you call them — this keeps your records in sync.</p>
            </div>
        </div>
    </div>
</div>
