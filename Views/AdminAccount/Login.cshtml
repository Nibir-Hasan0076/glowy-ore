@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login · GLOWY ORE</title>
    <link rel="icon" type="image/png" href="~/images/brand/favicon.png" />
    <link rel="apple-touch-icon" href="~/images/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-visual">
            <img class="auth-gem" src="~/images/brand/glowy-ore-logo.jpg" alt="GLOWY ORE logo" width="160" height="160" />
            <span class="eyebrow" style="color:rgba(255,255,255,.75);"><span class="spark" style="color:#F2D9A8;">✦</span> The studio</span>
            <h2>Your ornaments.<br />Your orders.<br />One pretty place.</h2>
            <p>Sign in to add new pieces, organise collections and keep every glow delivery moving.</p>
        </div>

        <div class="auth-form-wrap">
            <a class="brand" href="/">
                <span class="brand-gem">
                    <img src="~/images/brand/glowy-ore-logo.jpg" alt="" width="46" height="46" />
                </span>
                <span class="brand-words">
                    <span class="brand-name">GLOWY ORE</span>
                    <span class="brand-tag">Handcrafted ornaments</span>
                </span>
            </a>

            <h1>Welcome back.</h1>
            <p class="sub">Sign in to the GLOWY ORE studio.</p>

            <form method="post" action="/admin/login">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" placeholder="admin" autocomplete="username" autofocus />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button class="btn btn-primary btn-block" type="submit">Sign in</button>
            </form>

            <div class="auth-hint">
                <strong>Demo access:</strong> username <strong>admin</strong> · password <strong>Glowy@@123</strong><br />
                Change this later with your developer before going live.
            </div>

            <a class="auth-back" href="/">← Back to the store</a>
        </div>
    </div>
</body>
</html>
