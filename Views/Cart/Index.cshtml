@model CartViewModel
@{
    ViewData["Title"] = "Your bag";
    var remaining = 2000 - Model.Subtotal;
    var meterPct = (int)Math.Min(100, Math.Round(Model.Subtotal / 2000 * 100));
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow"><span class="spark">✦</span> Your bag</span>
        <h1>Your little bag of glow.</h1>
        <p>Everything you picked, in one soft pink place. Free delivery unlocks at ৳2,000.</p>
    </div>
</section>

<div class="container">
    @if (Model.Lines.Count == 0)
    {
        <div class="empty-state" data-reveal>
            <div class="empty-icon">✦</div>
            <h2>Your bag is feeling light</h2>
            <p>No ornaments in here yet. Let's find a little something that makes you glow.</p>
            <a class="btn btn-primary" href="/shop">Start shopping</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-list">
                @foreach (var line in Model.Lines)
                {
                    <div class="cart-line" data-reveal>
                        <a class="cart-thumb" href="/product/@line.Product.Slug">
                            <img src="/@(line.Product.PrimaryImage ?? "images/placeholder.svg")" alt="@line.Product.Name" loading="lazy" />
                        </a>
                        <div>
                            <span class="cart-line-cat">@line.Product.Category?.Name</span>
                            <a class="cart-line-name" href="/product/@line.Product.Slug">@line.Product.Name</a>
                            <div class="cart-line-meta">
                                <strong>@Format.Money(line.Product.Price)</strong>
                                <form class="qty-stepper" method="post" action="/cart/update">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@line.Product.Id" />
                                    <button type="submit" name="qty" value="@(line.Quantity - 1)" aria-label="Decrease quantity">−</button>
                                    <input type="text" value="@line.Quantity" readonly aria-label="Quantity" />
                                    <button type="submit" name="qty" value="@(line.Quantity + 1)" aria-label="Increase quantity">+</button>
                                </form>
                            </div>
                        </div>
                        <div class="cart-line-actions">
                            <strong>@Format.Money(line.LineTotal)</strong>
                            <form method="post" action="/cart/remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@line.Product.Id" />
                                <button class="remove-btn" type="submit">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <aside class="summary-card" data-reveal style="--delay:.1s">
                <h3>Order summary</h3>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong>@Format.Money(Model.Subtotal)</strong>
                </div>
                <div class="summary-row">
                    <span>Delivery</span>
                    <strong>@(Model.DeliveryFee == 0 ? "Free" : Format.Money(Model.DeliveryFee))</strong>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <strong>@Format.Money(Model.Total)</strong>
                </div>

                <div class="shipping-meter">
                    @if (remaining > 0)
                    {
                        <p>Add @Format.Money(remaining) more for free delivery</p>
                    }
                    else
                    {
                        <p>You've unlocked free delivery ✨</p>
                    }
                    <div class="bar"><span style="width:@meterPct%"></span></div>
                </div>

                <a class="btn btn-primary btn-block" href="/checkout">Checkout</a>
                <p class="summary-note">Cash on delivery · Gift wrapped · Questions? Message us on Facebook.</p>
                <a class="link-arrow" style="display:flex;justify-content:center;margin-top:16px;border:0;" href="/shop">Continue shopping <span>→</span></a>
            </aside>
        </div>
    }
</div>
